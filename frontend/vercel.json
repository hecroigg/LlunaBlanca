      "headers": {
        "Location": "/ca/"
      }
    },
    {
      "src": "/en",
      "status": 308,
      "headers": {
        "Location": "/en/"
      }
    },
    {
      "src": "/masajes-blanes",
      "status": 308,
      "headers": {
        "Location": "/masajes-blanes/"
      }
    },
    {
      "src": "/privacidad",
      "status": 308,
      "headers": {
        "Location": "/privacidad/"
      }
    },
    {
      "src": "/cookies",
      "status": 308,
      "headers": {
        "Location": "/cookies/"
      }
    },
    {

      }
    },
    {
      "src": "/(.*)/index.html",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/ca/(.*)",
      "dest": "/ca/404.html",
      "status": 404
    },
    {
      "src": "/en/(.*)",
      "dest": "/en/404.html",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
